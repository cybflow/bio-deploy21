# Copy this file to .env and fill in the values before deploying.

# Set to False in production
DEBUG=True

# Generate a strong random key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated list of domains/IPs that Django will respond to (production only)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
